# ==========================================
# CloudDocs Configuration
# ==========================================

# Application Environment (development, test, production)
APP_ENV=development
LOG_LEVEL=INFO
APP_PORT=8000

# Database Configuration
# PostgreSQL (Production & Docker Compose):
DATABASE_URL=postgresql://clouddocs:clouddocs_password@localhost:5432/clouddocs
# SQLite fallback for quick zero-config local runs:
# DATABASE_URL=sqlite:///./clouddocs.db

# Redis Cache & Presence
REDIS_URL=redis://localhost:6379/0

# Security & JWT Authentication
JWT_SECRET=change-this-super-secret-key-for-production-min-32-chars!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage Configuration
# Options: 'local' (development/testing) or 'r2' (production Cloudflare R2)
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./storage_data

# Cloudflare R2 Credentials (required only when STORAGE_PROVIDER=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=clouddocs-storage
R2_ENDPOINT=
R2_PUBLIC_DOMAIN=

# CORS Origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000

# Frontend API Connections
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Prometheus Metrics
METRICS_ENABLED=true
